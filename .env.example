PORT=3001

# Local dev
# FRONTEND_URL=http://localhost:5173

# Vercel production — set to your frontend Vercel URL (no trailing slash)
# FRONTEND_URL=https://your-legacy-app.vercel.app

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_publishable_key
SUPABASE_SECRET_KEY=your_secret_key
# Older name, also accepted:
# SUPABASE_SERVICE_ROLE_KEY=your_secret_key

DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project.supabase.co:5432/postgres

# OpenAI — Whisper STT + Realtime interviewer
OPENAI_API_KEY=your_openai_api_key
OPENAI_WHISPER_MODEL=whisper-1
OPENAI_TTS_MODEL=tts-1-hd
OPENAI_TTS_VOICE=nova
OPENAI_TTS_SPEED=0.94
OPENAI_REALTIME_MODEL=gpt-realtime
# Warm interviewer voices: coral, sage, ballad, verse (marin is crisper/more formal)
OPENAI_REALTIME_VOICE=coral
OPENAI_REALTIME_TRANSCRIPTION_MODEL=gpt-4o-transcribe
# Interview VAD — higher threshold / longer silence = less sensitive to ambient noise
OPENAI_REALTIME_VAD_THRESHOLD=0.72
OPENAI_REALTIME_SILENCE_MS=1500
OPENAI_REALTIME_PREFIX_PADDING_MS=300
# near_field | far_field | off
OPENAI_REALTIME_NOISE_REDUCTION=near_field

# AI interviewer voice
INTERVIEWER_TTS_PROVIDER=elevenlabs
INTERVIEWER_VOICE_ID=21m00Tcm4TlvDq8ikWAM
INTERVIEWER_TTS_MODEL=eleven_turbo_v2_5

ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_API_URL=https://api.anthropic.com/v1/messages
ANTHROPIC_VERSION=2023-06-01
ANTHROPIC_MODEL=claude-opus-4-8

# ElevenLabs — voice cloning + natural TTS
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_TTS_MODEL=eleven_turbo_v2_5
ELEVENLABS_STABILITY=0.4
ELEVENLABS_SIMILARITY_BOOST=0.75
ELEVENLABS_STYLE=0.15
ELEVENLABS_SPEAKER_BOOST=true

# Anam.ai — live video call with user's face + voice (required for Live Call)
ANAM_API_KEY=your_anam_api_key
ANAM_LLM_ID=ANAM_GPT_4O_MINI_V1
ANAM_AVATAR_MODEL=cara-4
ANAM_VIDEO_QUALITY=auto
# Live UI is a tall frame — portrait 768×1152. Set landscape only if you change the player.
ANAM_VIDEO_ORIENTATION=portrait
# enhance=true makes Anam clones sound generic. Leave off unless you want denoise.
ANAM_VOICE_ENHANCE=false

# Stripe — Set up $699, Monthly $69.90, Preserve $6.99, 30 min add $29.99
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_SETUP=price_...
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_PRESERVE=price_...
STRIPE_PRICE_ADDON=price_...
# Older complimentary / leftover subscribers still map through these:
STRIPE_PRICE_ARCHIVE=price_...
STRIPE_PRICE_FAMILY=price_...

# Staff admin at /admin — not a customer account. Keep this off public pages.
ADMIN_EMAIL=admin@legacy.ai
ADMIN_PASSWORD="change-this-password"
ADMIN_SESSION_SECRET=generate-a-long-random-string
